{
  "name": "dsh-vibe",
  "version": "1.3.0",
  "description": "Five ambient visual themes for DeepSeek Harness: Aurora, Ocean, Ember, Synthwave, and Manbo backgrounds with matching animated thinking HUDs.",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run lint && npm run format:check && npm test",
    "demos:render": "node scripts/render-demos.mjs"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "background",
    "effects",
    "themes",
    "aurora",
    "ocean",
    "ember",
    "synthwave",
    "manbo",
    "sci-fi"
  ],
  "author": "Unthropic",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unthropic/dsh-vibe.git"
  },
  "bugs": {
    "url": "https://github.com/unthropic/dsh-vibe/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "agent-browser": "0.32.3",
    "eslint": "10.9.0",
    "prettier": "3.9.6",
    "sharp": "0.35.3"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
